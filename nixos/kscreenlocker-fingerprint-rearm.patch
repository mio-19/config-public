+void UnlockApp::scheduleFingerprintRearm()
+{
+    if (!m_fingerprintRearmTimer) {
+        m_fingerprintRearmTimer = new QTimer(this);
+        m_fingerprintRearmTimer->setInterval(1000);
+        connect(m_fingerprintRearmTimer, &QTimer::timeout, this, &UnlockApp::pollFingerprintRearm);
+    }
+    m_fingerprintRearmAttempts = 0;
+    // Brief delay so a system fprintd restart on resume can begin.
+    QTimer::singleShot(1500, this, [this]() {
+        pollFingerprintRearm();
+        if (m_fingerprintRearmTimer && m_fingerprintRearmAttempts < 15) {
+            m_fingerprintRearmTimer->start();
+        }
+    });
+}
+
+void UnlockApp::pollFingerprintRearm()
+{
+    m_fingerprintRearmAttempts++;
+    QDBusInterface manager(QStringLiteral("net.reactivated.Fprint"),
+                           QStringLiteral("/net/reactivated/Fprint/Manager"),
+                           QStringLiteral("net.reactivated.Fprint.Manager"),
+                           QDBusConnection::systemBus());
+    if (manager.isValid()) {
+        const QDBusReply<QDBusObjectPath> reply = manager.call(QStringLiteral("GetDefaultDevice"));
+        if (reply.isValid() && !reply.value().path().isEmpty() && reply.value().path() != QLatin1String("/")) {
+            qCDebug(KSCREENLOCKER_GREET) << "UnlockApp: fprintd device ready at" << reply.value().path()
+                                         << "- rearming fingerprint PAM";
+            if (m_fingerprintRearmTimer) {
+                m_fingerprintRearmTimer->stop();
+            }
+            m_authenticators->rearmFingerprint();
+            return;
+        }
+    }
+    if (m_fingerprintRearmAttempts >= 15) {
+        qCWarning(KSCREENLOCKER_GREET) << "UnlockApp: giving up waiting for fprintd device after resume";
+        if (m_fingerprintRearmTimer) {
+            m_fingerprintRearmTimer->stop();
+        }
+    }
+}
