+void PamAuthenticators::rearmFingerprint()
+{
+    if (d->graceLocked) {
+        return;
+    }
+    for (auto &&noninteractive : d->noninteractive) {
+        if (!(noninteractive->authenticatorType() & PamAuthenticator::Fingerprint)) {
+            continue;
+        }
+        qCDebug(KSCREENLOCKER_GREET) << "PamAuthenticators: rearming fingerprint authenticator"
+                                     << qUtf8Printable(noninteractive->service());
+        noninteractive->cancel();
+        noninteractive->rearm();
+        noninteractive->tryUnlock();
+        setState(AuthenticatorsState::Authenticating);
+        return;
+    }
+}
