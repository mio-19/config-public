+void PamWorker::rearm()
+{
+    // Break any nested converse loop, then replace the PAM handle so pam_fprintd
+    // drops a stale D-Bus connection after fprintd restart (nixpkgs#432276).
+    Q_EMIT cancelled();
+    if (m_handle) {
+        pam_end(m_handle, PAM_SUCCESS);
+        m_handle = nullptr;
+    }
+    m_unavailable = false;
+    m_inAuthenticate = false;
+    Q_EMIT inAuthenticateChanged(m_inAuthenticate);
+    Q_EMIT unavailabilityChanged(m_unavailable);
+    start(m_service, m_user);
+    qCDebug(KSCREENLOCKER_GREET, "[PAM worker %s] rearm: PAM handle recreated", qUtf8Printable(m_service));
+}
+
+void PamAuthenticator::rearm()
+{
+    m_unlocked = false;
+    m_unavailable = false;
+    Q_EMIT availableChanged();
+    QMetaObject::invokeMethod(d, &PamWorker::rearm);
+}
